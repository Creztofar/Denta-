NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/smilecare.sqlite
CLINIC_TIMEZONE=Asia/Kolkata
SESSION_TTL_HOURS=12
RESET_TOKEN_TTL_MINUTES=30
# Demo accounts and sample content are created only outside production.
SEED_DEMO_DATA=true
# Required in production only when no SUPER_ADMIN account exists.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
